    "convex": "^1.17.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "sonner": "^1.2.0",
    "tailwind-merge": "^2.0.0",
    "zod": "^3.22.4"
  },
