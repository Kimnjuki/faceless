{
  "name": "content-anonymity",
  "private": true,
  "version": "1.0.0",
  "description": "ContentAnonymity - Privacy-first creator platform for faceless content",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --skipLibCheck && vite build",
    "build:quick": "vite build",
    "prepare:react-snap": "node scripts/prepare-react-snap.mjs",
    "inject:seo": "node scripts/inject-route-seo.mjs",
    "prerender:routes": "node scripts/prerender-routes.mjs",
    "build:prerender": "npm run build:quick && npm run prerender:routes && npm run prepare:react-snap && react-snap",
    "build:seo": "npm run build:quick && npm run prerender:routes && npm run seo:check",
    "build:check": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "verify:canonical": "node scripts/verify-canonical.mjs",
    "verify:prerender": "node scripts/verify-prerender.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:links": "node scripts/link-audit.mjs",
    "check:csv": "node scripts/validate-csv.mjs",
    "check:sitemap": "node scripts/check-sitemap-hygiene.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "generate:niche-longform": "node scripts/generate-niche-longform.mjs",
    "deploy:convex": "npx convex deploy --yes",
    "import-articles": "node scripts/import-articles-from-csv.mjs",
    "import-all": "node scripts/import-all-from-csv.mjs",
    "seed:faceless-article": "npx convex run seedFacelessArticle:run",
    "seed:platform-guides": "npx convex run seedPlatformGuides:run"
  },
