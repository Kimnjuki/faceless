{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/creator-studio",
      "destination": "/index.html"
    },
    {
      "source": "/creator-studio/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/checkout/(.*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.contentanonymity.com"
        }
      ],
      "destination": "https://contentanonymity.com/:path*",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/platform-guides/guide-1770820903899-ataf0t3",
      "destination": "/platform-guides",
      "permanent": true
    },
    {
      "source": "/platform-guides/guide-1769626646112-qd6zhg3",
      "destination": "/platform-guides",
      "permanent": true
    },
    {
      "source": "/platform-guides/guide-1770820898330-gqu3rld",
      "destination": "/platform-guides",
      "permanent": true
    },
    {
      "source": "/platform-guides/guide-1769626107741-7zwtp46",
      "destination": "/platform-guides",
      "permanent": true
    },
    {
      "source": "/platform-guides/guide-1769626640492-sjftml0",
      "destination": "/platform-guides",
      "permanent": true
    },
    {
      "source": "/platform-guides/guide-1770820901797-xss9poy",
      "destination": "/platform-guides",
      "permanent": true
    },
    {
      "source": "/platform-guides/guide-1769626099225-x7fgq60",
      "destination": "/platform-guides",
      "permanent": true
    }
  ]
}
